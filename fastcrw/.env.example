# LLM connection (defaults to local vLLM)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
LLM_API_KEY=vllm

# SearXNG secret key (generate with: openssl rand -hex 32)
SEARXNG_SECRET_KEY=change-me-with-openssl-rand-hex-32-please

# Browserless token (generate with: openssl rand -hex 24)
BROWSERLESS_TOKEN=change-me-with-openssl-rand-hex-24-please
