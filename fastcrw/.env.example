# CRW Renderer settings
CRW_RENDERER__CHROME_CONTEXT_POOL_ENABLED=true
CRW_RENDERER__CHROME_BACKEND=vanilla
CRW_RENDERER__CHROME_POOL__SIZE=4

# SearXNG secret key (generate with: openssl rand -hex 32)
SEARXNG_SECRET_KEY=change-me-with-openssl-rand-hex-32-please

# Browserless token (generate with: openssl rand -hex 24)
BROWSERLESS_TOKEN=crwtest
